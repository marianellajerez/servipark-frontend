      "headers": [ { "name": "Content-Type", "value": "application/json" }, { "name": "Authorization", "value": "Bearer {{ response \"req_login\" \"body.token\" }}" } ],
      "body": { "mimeType": "application/json", "text": "{\n  \"nombre\": \"Carro\",\n  \"valorPorMinuto\": 0.5\n}" }
