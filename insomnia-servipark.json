      "parentId": "fld_auth",
      "name": "Auth - Login",
      "method": "POST",
      "url": "{{ base_url }}/api/v1/auth/login",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"correo\": \"admin@servipark.com\",\n  \"contrasena\": \"Marianella123!\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ]
    },

    {
